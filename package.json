{
  "name": "dsh-readme-polish",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin and portable Agent Skill: upgrade an existing README to the top-repo standard of its own ecosystem.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "SKILL.md",
    "references",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/provider.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/readme-polish.git"
  },
  "homepage": "https://github.com/zhengqiuyang/readme-polish",
  "bugs": {
    "url": "https://github.com/zhengqiuyang/readme-polish/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "readme"
  ],
  "author": "zhengqiuyang",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
